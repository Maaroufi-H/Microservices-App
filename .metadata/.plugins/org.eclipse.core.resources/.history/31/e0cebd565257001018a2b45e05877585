	public static <T> void print(T[] t) {
	 Arrays.stream(t).forEach(e -> System.out.print(e));
	}
	
	public static <T> void sort(List<Integer> list) {
	//	List<Integer> list2 = list.stream().sorted().toList().reversed();
		list.sort( (e1,e2) -> e2.compareTo(e1));
		System.out.println(list);
	}
	
	public static <T> void printArray(T[] array) {
	    for (T element : array) {
	        System.out.print(element + " ");
	    }
	    System.out.println();
	}
	
    
    public static void filter(List<Integer> list) {
      var filteredList = list.stream().filter(e -> e%2==0).collect(Collectors.toList());
      System.out.println(filteredList);
    }
    
    public static<A> void toUpperCase(List<String> list){
    	var upperList = list.stream().map(element -> element.toUpperCase()).collect(Collectors.toList());
        System.out.println(upperList);

    }

