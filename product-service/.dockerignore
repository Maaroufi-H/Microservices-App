# 1. Version control
.git/
.gitignore
.hg/
.svn/

# 2. IDE and editor files
.idea/
.vscode/
*.swp
*.swo
.settings/
.project
.classpath
.factorypath

# 3. Java build outputs
# (Do NOT ignore .mvn/ or mvnw as per instructions)
target/
*.class

# 4. Other build outputs
dist/
build/
out/

# 5. Test and debug artifacts
test/
tests/
debug/
*.log

# 6. Documentation and markdown
docs/
*.md
README*
HELP.md

# 7. Temporary and local files
tmp/
temp/
*.tmp
.local/
local/

# 8. Environment and secrets
.env*
*.env
*.pem
*.key
*.crt
config.local.*
*.local.yml

# 9. Node.js, Python, Go (for completeness, even if not detected)
node_modules/
npm-debug.log
yarn-debug.log
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.coverage
/vendor/
*.test
.go-cache/

# 10. Docker and Compose files
Dockerfile*
docker-compose*

# 11. Miscellaneous
*.prefs
.gitattributes
